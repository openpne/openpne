APP_NAME=OpenPNE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Site timezone (IANA name, e.g. Asia/Tokyo). Both storage and display use this wall clock, so
# changing it later reinterprets every DATETIME already stored — set it before the first write.
APP_TIMEZONE=UTC

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Behind a reverse proxy, set this to the proxy IP/CIDR list (comma-separated) or "*" to trust its
# forwarded headers, so $request->ip()/scheme reflect the real client. Empty = trust none.
TRUSTED_PROXIES=
# Generate https URLs and Secure cookies regardless of how the request reached PHP. Defaults on
# when APP_ENV=production; set false only for a deliberate plain-HTTP host.
# OPENPNE_FORCE_HTTPS=true

# Reject commonly-used and context-related passwords (site name, email, member name, admin username)
# on top of the length policy. Set false only in a dev environment; min length and the byte cap stay.
OPENPNE_PASSWORD_BLOCKLIST=true

# Strip EXIF/GPS (and XMP/comments) from uploaded jpeg/png/webp losslessly, so shared photos don't
# leak location. Defaults on; set false to retain EXIF (e.g. a photography community).
# OPENPNE_STRIP_IMAGE_METADATA=true

# Per-minute caps on member content/message/friend/group writes (per-member limb + looser per-IP
# limb). 0 disables a limb; set the *_IP limbs to 0 behind a shared NAT/proxy. Defaults shown.
# OPENPNE_THROTTLE_POSTING=30
# OPENPNE_THROTTLE_POSTING_IP=60
# OPENPNE_THROTTLE_DIRECT_MESSAGE=10
# OPENPNE_THROTTLE_DIRECT_MESSAGE_IP=30
# OPENPNE_THROTTLE_FRIEND=15
# OPENPNE_THROTTLE_FRIEND_IP=40
# OPENPNE_THROTTLE_GROUP=15
# OPENPNE_THROTTLE_GROUP_IP=40
# OPENPNE_THROTTLE_REACTION=60
# OPENPNE_THROTTLE_REACTION_IP=120

# The MCP endpoint (docs/internals/mcp.md), per token and — before any credential is read — per IP.
# OPENPNE_THROTTLE_MCP=60
# OPENPNE_THROTTLE_MCP_IP=60

# Web push (browser notifications). Unset = the whole feature is off: nothing is offered to members
# and nothing is sent. To switch it on, run `php artisan webpush:vapid --show` and copy the two
# printed values here — the command without --show writes VAPID_* names, which this app ignores.
# The keypair is this site's identity to the push services, so replacing it invalidates every
# subscription members have already made. SUBJECT defaults to APP_URL; a mailto: address also works.
# OPENPNE_VAPID_PUBLIC_KEY=
# OPENPNE_VAPID_PRIVATE_KEY=
# OPENPNE_VAPID_SUBJECT=

# Extra address ranges this site may never fetch from, comma-separated CIDRs, on top of the built-in
# non-global list. For an internal range that resolves publicly, or a network-specific NAT64 prefix
# (which cannot be recognised from the address alone). Adds only — it cannot re-permit a rejected
# address. A malformed range is an error, not a skipped entry. See docs/internals/outbound-http.md.
# OPENPNE_OUTBOUND_DENIED_CIDRS=198.18.0.0/15,2001:db8::/32

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_SECURITY_DAYS=90

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Serving real traffic from SQLite? Set this before that traffic arrives.
# DB_JOURNAL_MODE=WAL
# OFF, NORMAL, FULL (the default) or EXTRA. NORMAL is the usual companion to WAL.
# DB_SYNCHRONOUS=NORMAL

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Admin-surface session cookie (defaults to "<app-name-slug>-admin-session")
# SESSION_ADMIN_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
