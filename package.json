        "@tiptap/core": "3.33.0",
        "@tiptap/extension-table": "3.33.0",
        "@tiptap/markdown": "3.33.0",
        "@tiptap/pm": "3.33.0",
        "@tiptap/react": "3.33.0",
        "@tiptap/starter-kit": "3.33.0",
        "altcha": "^3.5.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-react-i18n": "^2.0.5",
        "lucide-react": "^1.70.0",
        "marked": "18.1.3",
