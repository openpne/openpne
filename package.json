        "@tiptap/starter-kit": "3.30.5",
        "altcha": "^3.2.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-react-i18n": "^2.0.5",
        "lucide-react": "^1.37.0",
        "marked": "18.0.11",
        "radix-ui": "^1.6.7",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
